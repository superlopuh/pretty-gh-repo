#set page(
  width: 13.33in,
  height: 7.5in,
  margin: 0.5in,
)

#set text(font: "Mona Sans", size: 20pt)

#show heading: it => [
  #set text(33pt)
  #text(it.body, font: "Mona Sans")
]

#let repo = json("repos/xdslproject/xdsl-torch/repo.json")

= #repo.full_name

*#repo.stars ⭐️*

#repo.commit_count commits

#for author in repo.authors {
  stack(dir: ltr, box(clip: true, radius: 1cm, width: 2cm, height: 2cm, image("avatars/" + author)), align(
    horizon,
  )[#text(
      "   @" + author,
      font: "Mona Sans",
    )])
}

